<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Phát Video Trực Tuyến</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-color: #3b82f6;
            --accent-hover: #2563eb;
            --border-color: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            text-align: center;
        }

        header h1 {
            font-size: 1.5rem;
            color: var(--text-color);
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 2rem;
            flex: 1;
            width: 100%;
        }

        @media (max-width: 900px) {
            .container {
                grid-template-columns: 1fr;
            }
        }

        .video-section {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
        }

        .video-container {
            position: relative;
            padding-bottom: 56.25%; /* Tỷ lệ khung hình 16:9 */
            height: 0;
            background: #000;
        }

        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        .video-info {
            padding: 1.5rem;
        }

        .video-info h2 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
        }

        .video-info p {
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
        }

        .card h3 {
            font-size: 1.1rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        textarea {
            width: 100%;
            height: 120px;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-color);
            padding: 0.75rem;
            resize: vertical;
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }

        textarea:focus {
            outline: none;
            border-color: var(--accent-color);
        }

        button {
            background-color: var(--accent-color);
            color: white;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
            width: 100%;
        }

        button:hover {
            background-color: var(--accent-hover);
        }

        .playlist-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.50rem;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .playlist-item:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .playlist-item.active {
            background-color: rgba(59, 130, 246, 0.15);
            border-left: 3px solid var(--accent-color);
        }

        .playlist-thumb {
            width: 60px;
            height: 35px;
            background-color: #334155;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .playlist-details h4 {
            font-size: 0.9rem;
            margin-bottom: 0.2rem;
        }

        .playlist-details span {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        footer {
            text-align: center;
            padding: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.85rem;
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }
    </style>
</head>
<body>

    <header>
        <h1>🎥 Trang Phát Video Trực Tuyến</h1>
    </header>

    <div class="container">
        <div class="video-section">
            <div class="video-container">
                <iframe id="main-video" src="https://drive.google.com/file/d/1NeL9qLTbHcBC9PSEGjhEa4ciIa4AqhId/preview" allow="autoplay" allowfullscreen></iframe>
            </div>
            <div class="video-info">
                <h2 id="video-title">tap san.mov</h2>
                <p id="video-desc">Video phát trực tuyến từ Google Drive không giới hạn thời gian.</p>
            </div>
        </div>

        <div class="sidebar">
            <div class="card">
                <h3>📝 Ghi chú cá nhân</h3>
                <textarea id="note-input" placeholder="Nhập ghi chú của bạn..."></textarea>
                <button onclick="saveNote()">Lưu ghi chú</button>
            </div>

            <div class="card">
                <h3>📂 Danh sách video</h3>
                <div class="playlist-item active">
                    <div class="playlist-thumb">▶</div>
                    <div class="playlist-details">
                        <h4>tap san.mov</h4>
                        <span>Google Drive</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 - Hoạt động vĩnh viễn.</p>
    </footer>

    <script>
        function saveNote() {
            const noteText = document.getElementById('note-input').value;
            if(noteText.trim() === "") {
                alert("Vui lòng nhập nội dung ghi chú!");
                return;
            }
            localStorage.setItem('video_note', noteText);
            alert("Đã lưu ghi chú thành công!");
        }

        window.onload = function() {
            const savedNote = localStorage.getItem('video_note');
            if(savedNote) {
                document.getElementById('note-input').value = savedNote;
            }
        }
    </script>
</body>
</html>
